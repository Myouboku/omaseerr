{
  "schemaVersion": 1,
  "id": "myouboku.omaseerr",
  "name": "OmaSeerr",
  "version": "0.1.0",
  "author": "myouboku",
  "license": "MIT",
  "description": "Seerr media requests in the Omarchy bar: review, approve and decline requests, with actionable notifications.",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Seerr",
    "description": "Pending Seerr requests with filters, details, advanced approval and notifications.",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "url": "",
      "refreshIntervalSec": 60,
      "notifyNewRequests": true,
      "notifyStatusChanges": false,
      "notifyOnStartup": false,
      "notifyUrgency": "normal",
      "notifyPoster": true,
      "notifyGroupThreshold": 3,
      "defaultFilter": "pending",
      "defaultMediaType": "all",
      "defaultSort": "added",
      "defaultSortDirection": "desc",
      "pageSize": 20,
      "showPosters": true,
      "showBadge": true,
      "badgeWhenEmpty": false,
      "confirmDecline": true
    },
    "schema": [
      { "key": "url", "type": "string", "label": "Seerr URL", "defaultValue": "",
        "description": "http:// or https:// address of your Seerr instance. The API key is not set here: it lives in the keyring and is entered from the panel's settings." },
      { "key": "refreshIntervalSec", "type": "integer", "label": "Check for new requests every (seconds)", "min": 15, "max": 3600, "step": 15, "defaultValue": 60 },
      { "key": "notifyNewRequests", "type": "boolean", "label": "Notify new requests", "defaultValue": true,
        "description": "Notifications carry Details, Approve and Decline buttons. Approve from a notification uses Seerr's defaults." },
      { "key": "notifyStatusChanges", "type": "boolean", "label": "Notify status changes", "defaultValue": false,
        "description": "When a request becomes available or fails." },
      { "key": "notifyOnStartup", "type": "boolean", "label": "Announce existing requests on first connection", "defaultValue": false },
      { "key": "notifyUrgency", "type": "enum", "label": "Notification urgency", "options": ["low", "normal", "critical"], "defaultValue": "normal" },
      { "key": "notifyPoster", "type": "boolean", "label": "Poster in notifications", "defaultValue": true,
        "description": "Downloaded from image.tmdb.org and cached in ~/.cache/omaseerr." },
      { "key": "notifyGroupThreshold", "type": "integer", "label": "Group notifications from this many new requests", "min": 1, "max": 20, "step": 1, "defaultValue": 3,
        "description": "1 never groups." },
      { "key": "defaultFilter", "type": "enum", "label": "Default status filter",
        "options": ["pending", "approved", "processing", "available", "failed", "declined", "all"], "defaultValue": "pending" },
      { "key": "defaultMediaType", "type": "enum", "label": "Default media type", "options": ["all", "movie", "tv"], "defaultValue": "all" },
      { "key": "defaultSort", "type": "enum", "label": "Default sort", "options": ["added", "modified"], "defaultValue": "added" },
      { "key": "defaultSortDirection", "type": "enum", "label": "Default order", "options": ["desc", "asc"], "defaultValue": "desc" },
      { "key": "pageSize", "type": "integer", "label": "Requests per page", "min": 5, "max": 100, "step": 5, "defaultValue": 20 },
      { "key": "showPosters", "type": "boolean", "label": "Show posters", "defaultValue": true,
        "description": "Loaded from image.tmdb.org." },
      { "key": "showBadge", "type": "boolean", "label": "Pending count on the bar icon", "defaultValue": true },
      { "key": "badgeWhenEmpty", "type": "boolean", "label": "Show the count when it is zero", "defaultValue": false },
      { "key": "confirmDecline", "type": "boolean", "label": "Confirm before declining", "defaultValue": true }
    ]
  }
}
